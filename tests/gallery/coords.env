# Where the gallery's controls are, in layout pixels on the 1280x800 output (the drive's extent
# is set to match). The scripts in this directory use these names; when the gallery's layout
# changes (examples/gallery/), update the numbers here and nothing else.

# A medium tinted button, to hover.
HOVER_X=545
HOVER_Y=62
# A medium filled button, to hold pressed.
PRESS_X=615
PRESS_Y=62
# The ScrollView's list, to wheel over.
SCROLL_X=220
SCROLL_Y=735
# The TextField, to click and type into.
FIELD_X=555
FIELD_Y=412
# The slider's thumb (at 40 percent) and a point further right, to drag it to.
SLIDER_X=668
SLIDER_Y=310
SLIDER_TO_X=735

# Page 2 (GALLERY_PAGE=2; drive scripts that start with "# page: 2"). The raw-states boxes:
# row one is fill, all four, group, tab; row two is focus, press, lift. Each is 78x52.
ST_FILL_X=918
ST_ALL_X=1006
ST_GROUP_X=1094
ST_TAB_X=1182
ST_ROW1_Y=108
ST_FOCUS_X=918
ST_PRESS_X=1006
ST_LIFT_X=1094
ST_ROW2_Y=198
# The nested scrollers: the vertical one in its rounded card, the horizontal one in its pill.
NEST_Y_X=1060
NEST_Y_Y=487
NEST_X_X=1060
NEST_X_Y=633

# Page 3 (GALLERY_PAGE=3): the kit's newer components.
