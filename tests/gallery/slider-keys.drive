# shot-at: 3400
# page: 3
# Tab to the slider and press Right ten times, then Shift+Right once: it moves.
extent 1280 800
move 300 300
glide $K_SWITCH_X $K_ROW_Y 200
click left
sleep 200
key Tab
key Right Right Right Right Right Right Right Right Right Right
chord shift+Right
move 300 300
sleep 300
sleep 3000
