#!/usr/bin/env python3
"""Write INPUT as a C string constant NAME into OUTPUT: embed-file NAME INPUT OUTPUT."""
import sys

name, source, target = sys.argv[1:4]
data = open(source, "rb").read()
escaped = "".join("\\x%02x" % byte for byte in data)
lines = [escaped[i:i + 128] for i in range(0, len(escaped), 128)]
with open(target, "w") as out:
    out.write("static const char %s[] =\n" % name)
    out.write("\n".join('    "%s"' % line for line in lines) or '    ""')
    out.write(";\n")
