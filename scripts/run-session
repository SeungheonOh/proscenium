#!/bin/sh
# Run proscenium as the desktop on this seat, as a systemd user unit, directing it
# with WORLD (default examples/deck.tsx). Another compositor owning the seat must
# stop first. The log goes to $XDG_STATE_HOME/proscenium/run.log.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
world=$(realpath "${1:-$root/examples/deck.tsx}")
[ -f "$world" ] || { echo "run-session: $world is not a world file" >&2; exit 2; }
state="${XDG_STATE_HOME:-$HOME/.local/state}/proscenium"
mkdir -p "$state"
systemctl --user stop proscenium-compositor.service 2>/dev/null || true
systemctl --user reset-failed proscenium-compositor.service 2>/dev/null || true
echo "=== $(date) $world ===" >> "$state/run.log"
systemd-run --user --unit=proscenium-compositor --working-directory="$root" \
    -E WLR_BACKENDS=drm,libinput -E PATH="$PATH" \
    -p StandardOutput=append:"$state/run.log" -p StandardError=append:"$state/run.log" \
    /usr/bin/env -u WAYLAND_DISPLAY -u DISPLAY "$root/build/meson/proscenium" --script "$world"
